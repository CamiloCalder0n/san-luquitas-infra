# Copiar a .env y cambiar las claves. El .env NUNCA se sube al repo.

APP_NAME="Portal Institucional San Luquitas"
APP_ENV=production
# Generar con: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=http://sanluquitas.local:8080
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Logs a la salida del contenedor (se ven con docker compose logs)
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Base de datos del portal (contenedor db)
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portal_sanluquitas
DB_USERNAME=portal_user
DB_PASSWORD=cambiar_esta_clave
DB_ROOT_PASSWORD=cambiar_esta_clave_root

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Enlace a la plataforma Moodle
MOODLE_URL=http://sanluquitas.local

# Ejecutar migraciones al iniciar el contenedor
RUN_MIGRATIONS=true
